      "device": "default"
    },
    "_meta": {
      "title": "Managed text encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "_meta": {
      "title": "VAE"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "A small cobalt-blue ceramic teapot on a wooden table beside a window, warm morning light, soft natural shadows, a quiet still-life photograph, simple uncluttered background."
    },
    "_meta": {
      "title": "Image prompt"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "4",
        0
      ]
