      "title": "Euler sampler"
    }
  },
  "9": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": 4,
      "width": 512,
      "height": 512
    },
    "_meta": {
      "title": "FLUX.2 distilled schedule"
    }
  },
  "10": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "1",
        0
      ],
