    "_meta": {
      "title": "Distilled CFG"
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "7",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "8",
        0
      ],
      "sigmas": [
        "9",
        0
      ],
      "latent_image": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "Sample image"
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Decode image"
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "image/general"
    },
    "_meta": {
      "title": "Image output"
    }
