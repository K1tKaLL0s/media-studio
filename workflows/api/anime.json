{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "anima-turbo-v1.1.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Diffusion model"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_06b_base.safetensors",
      "type": "stable_diffusion",
      "device": "cpu"
    },
    "_meta": {
      "title": "Text encoder on CPU"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "VAE"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "1girl, solo, original character, anime illustration, blue jacket, short black hair, warm smile, plain light background, clean lineart, soft colors"
    },
    "_meta": {
      "title": "Anime prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "worst quality, low quality, blurry, jpeg artifacts, malformed hands, extra fingers, text, watermark"
    },
    "_meta": {
      "title": "Anime negative prompt"
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    },
    "_meta": {
      "title": "Output size"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": 42,
      "steps": 10,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "Anima Turbo sampler"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Decode anime image"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "image/anime"
    },
    "_meta": {
      "title": "Anime image output"
    }
  }
}
